<?xml version="1.0" encoding="utf-8"?>
<!-- Offline document editor. Cloud backup includes editor settings and documents created
     and owned by this app. Recently opened URI references are not included because external
     document providers may not resolve them after restore, and their names can be sensitive.
     Other internal app data, including DataStore preferences, is not explicitly allowlisted. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="office_settings.xml" />
        <include domain="file" path="documents" />
    </cloud-backup>
    <device-transfer>
        <!-- External-storage data is excluded from device-to-device transfer. -->
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
